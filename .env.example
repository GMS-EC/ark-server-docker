# ==========================================================
# ARK Server Manager - Variables de Entorno de Docker (.env)
# ==========================================================
# En la versión 2.0+, el contenedor solo requiere variables
# de infraestructura de red, zona horaria y acceso al panel web.
#
# Toda la configuración del juego (Nombre del servidor, contraseñas,
# mapa, mods de Steam Workshop, webhooks de Discord, horarios de actividad,
# respaldos automáticos y multiplicadores de rates) se administra 100%
# desde la Interfaz Web (http://localhost:8080).
# ==========================================================

# --- Credenciales del Panel Web ARK Server Manager ---
# ¡IMPORTANTE! Cambia estas contraseñas por defecto antes de exponer el panel
# a tu red/Internet. El panel sirve HTTP sin cifrado; usa un proxy TLS si es accesible
# desde fuera de tu casa/LAN.
PANEL_USER=admin
PANEL_PASSWORD=adminpassword

# --- Zona Horaria del Contenedor ---
TZ=America/Guayaquil

# --- Permisos de Archivos (Linux PUID/PGID - Opcional) ---
PUID=1000
PGID=1000
