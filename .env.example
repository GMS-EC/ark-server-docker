# ==========================================================
# ARK Server Manager - Variables de Entorno de Docker (.env)
# ==========================================================
# En la versión 2.0+, solo necesitas definir aquí las credenciales
# de acceso al panel web y los parámetros fundamentales de red/hardware.
#
# Todo lo demás (Webhooks de Discord, Horarios de Actividad, Respaldos,
# Dino Wipes, Mods de Workshop y Multiplicadores de tasas) se configura
# y administra dinámicamente desde la Interfaz Web (http://localhost:8080)
# sin necesidad de reiniciar el contenedor ni duplicar variables.
# ==========================================================

# --- Credenciales del Panel Web ARK Server Manager ---
PANEL_PORT=8080
PANEL_USER=admin
PANEL_PASSWORD=adminpassword
AUTOSTART_SERVER=true
# SECRET_KEY=   # Opcional: Clave criptográfica para firmas de sesión. Se autogenera y persiste en disco si se omite.

# --- Permisos de Archivos (Linux PUID/PGID) ---
PUID=1000
PGID=1000

# --- Identificación y Servidor de ARK ---
SESSION_NAME=ARK Server
SERVER_PASSWORD=
ADMIN_PASSWORD=adminpass
MAX_PLAYERS=10
WORLD=TheIsland

# --- Red y Puertos ---
SERVER_PORT=7777
QUERY_PORT=27015
RCON_PORT=27020
RCON_ENABLED=true

# --- Modo de Juego Básico ---
SERVER_PVE=false
BATTLEEYE=false

# --- Argumentos adicionales y rama de Steam (Opcional) ---
ADDITIONAL_ARGS=
BETA=public
UPDATE_ON_START=true

# --- Zona Horaria ---
TZ=UTC

# --- Directorios de Volúmenes en el Contenedor ---
BACKUP_DIR=/home/steam/ark-backups
CLUSTER_DIR_OVERRIDE=/home/steam/clusters
